{
  "firestore": {
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "storage": {
    "rules": "firebase/storage.rules"
  },
  "functions": [
    {
      "source": "apps/functions/dist",
      "codebase": "default",
      "runtime": "nodejs22"
    }
  ],
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "functions": {
      "port": 5001
    },
    "singleProjectMode": true,
    "ui": {
      "enabled": false
    },
    "hosting": {
      "port": 5005
    }
  },
  "hosting": {
    "public": "apps/web/out",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*"
    ],
    "redirects": [
      {
        "source": "/chat",
        "destination": "/",
        "type": 302
      },
      {
        "source": "/activity",
        "destination": "/",
        "type": 302
      },
      {
        "source": "/accounts",
        "destination": "/",
        "type": 302
      },
      {
        "source": "/accounts/new",
        "destination": "/",
        "type": 302
      },
      {
        "source": "/reports",
        "destination": "/",
        "type": 302
      },
      {
        "source": "/reminders",
        "destination": "/",
        "type": 302
      },
      {
        "source": "/settings",
        "destination": "/",
        "type": 302
      },
      {
        "source": "/onboarding",
        "destination": "/",
        "type": 302
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  }
}
