{
  "name": "moneytrace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "build:functions": "pnpm --filter @moneytrace/functions build",
    "drill:seed": "tsx tools/restore-drill/drill.ts seed",
    "drill:verify": "tsx tools/restore-drill/drill.ts verify",
    "deploy:staging": "pnpm build:functions && firebase deploy --project staging --only firestore,storage,functions",
    "test": "vitest run --passWithNoTests",
    "test:emulator": "pnpm build:functions && firebase emulators:exec --project demo-moneytrace --only auth,firestore,storage,functions \"vitest run --config vitest.emulator.config.ts\"",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.tools.json",
    "lint": "eslint .",
    "boundaries": "depcruise packages apps --config .dependency-cruiser.cjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm boundaries && pnpm test"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@moneytrace/contracts": "workspace:*",
    "@moneytrace/domain": "workspace:*",
    "@moneytrace/infrastructure": "workspace:*",
    "@types/node": "22.20.5",
    "@vitejs/plugin-react": "6.2.1",
    "dependency-cruiser": "18.7.2",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "firebase": "13.2.0",
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0",
    "firebase-tools": "15.35.0",
    "prettier": "3.9.10",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  }
}
