{
  "name": "moneytrace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "test:e2e": "bash tools/e2e/local-supabase.sh",
    "test": "vitest run --passWithNoTests",
    "test:e2e:fixture": "NEXT_PUBLIC_DATA_SOURCE=fixture pnpm --filter web build && playwright test --config=e2e/fixture/playwright.config.ts",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.tools.json",
    "lint": "eslint .",
    "boundaries": "depcruise packages apps --config .dependency-cruiser.cjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm boundaries && pnpm test",
    "serve:web": "node tools/serve-web/serve-web.mjs",
    "build:supabase": "node apps/functions/build-supabase.mjs",
    "smoke:supabase": "pnpm build:supabase && node apps/functions/test/deno-smoke.mjs",
    "deploy:supabase": "node tools/deploy/supabase-secrets.mjs && pnpm build:supabase && pnpm dlx supabase@2.122.0 db push --linked && pnpm dlx supabase@2.122.0 functions deploy api --use-api --no-verify-jwt"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@moneytrace/contracts": "workspace:*",
    "@moneytrace/domain": "workspace:*",
    "@moneytrace/infrastructure": "workspace:*",
    "@playwright/test": "1.51.1",
    "@types/node": "22.20.5",
    "@vitejs/plugin-react": "6.2.1",
    "age-encryption": "0.3.1",
    "dependency-cruiser": "18.7.2",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  }
}
